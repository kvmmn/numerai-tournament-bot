NUMERAI_PUBLIC_ID=your_public_id
NUMERAI_SECRET_KEY=your_secret_key

# Optional: explicit models to submit, comma-separated
# NUMERAI_MODEL_NAMES=kvmmn,kvmmn_fn,kvmmn_te
# Required when the account has more than one model. A readiness packet targets
# exactly one model so identical predictions are never broadcast accidentally.
# SUBMISSION_TARGET_MODEL=kvmmn_te

# Core workflow config
DATA_VERSION=v5.2
MODEL_NAME=baseline_lgbm
FEATURE_SET=small
TRAIN_ERA_STRIDE=4
MIN_TRAIN_ERAS=100
NEUTRALIZATION_PROPORTION=0.75

# Retained for compatibility. The durable control plane always requires a
# challenge-bound human approval before submission.
AUTO_APPROVE_SUBMISSION=false

# Durable approval, audit, and idempotency state
APPROVAL_TTL_MINUTES=180
SUBMISSION_MIN_UNIQUE_PREDICTIONS=100

# Staking is disabled until explicit non-zero caps are configured. Every change
# still requires a separate proposal, approval challenge, and exact confirmation.
MAX_TOTAL_STAKE_NMR=0
MAX_MODEL_STAKE_NMR=0
MAX_STAKE_CHANGE_NMR=0

# Current Grandmasters qualification defaults. Review official Numerai rules
# before changing these values.
SEASON_QUALIFYING_ROUNDS=20
SEASON_MIN_AT_RISK_NMR=1.0
ACCOUNT_RANK_SCAN_LIMIT=1000

# Numerai MCP server (alternative MCP-first workflow)
# Per Numerai docs:
# NUMERAI_MCP_AUTH format is "Token PUBLIC_KEY$PRIVATE_KEY"
NUMERAI_MCP_URL=https://api-tournament.numer.ai/mcp/sse
# NUMERAI_MCP_AUTH=Token your_public_id$your_secret_key
NUMERAI_MCP_USE_SSE=true

# Optional explicit MCP tool mapping; if unset, backend will infer best matches from tools/list
# NUMERAI_MCP_TOOL_CURRENT_ROUND=current_round
# NUMERAI_MCP_TOOL_SYNC_DATA=sync_data
# NUMERAI_MCP_TOOL_TRAIN_MODEL=train_model
# NUMERAI_MCP_TOOL_EVALUATE_MODEL=evaluate_model
# NUMERAI_MCP_TOOL_SUBMIT_PREDICTIONS=submit_predictions
